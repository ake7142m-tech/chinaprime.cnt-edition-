# ============================================================
# China Prime — New Feature Environment Variables
# Copy relevant sections to your .env.local
# ============================================================

# ── Payment Gateway (Omise) ──────────────────────────────────
# Get keys from https://dashboard.omise.co → Settings → Keys
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxx
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxx
OMISE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# PromptPay receiving phone/tax ID (your business PromptPay)
PROMPTPAY_PHONE=0812345678
# or use tax ID instead:
# PROMPTPAY_TAX_ID=0105500000000

# ── SMS Provider ─────────────────────────────────────────────
# Options: telnyx | twilio | log  (log = console only, for dev)
SMS_PROVIDER=log

# Telnyx (recommended for Thailand)
# Get API key from https://portal.telnyx.com
TELNYX_API_KEY=KEY0xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_MESSAGING_PROFILE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SMS_FROM_NUMBER=+66XXXXXXXXXX
# or use Sender ID (requires carrier registration in Thailand):
# SMS_FROM_NUMBER=CHINAPRIME

# Twilio (alternative)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_FROM_NUMBER=+66XXXXXXXXXX   # same var, set once

# ── Seat Inventory Sync ──────────────────────────────────────
# Options: nok_air | thai_lion | tour_operator | none
SEAT_PROVIDER=none
SEAT_PROVIDER_API_URL=https://api.youroperator.com
SEAT_PROVIDER_API_KEY=your_api_key_here

# Secret for POST /api/seats/sync (protect from unauthorized callers)
SEATS_SYNC_SECRET=a_strong_random_secret_here

# ── Cron Auth (Vercel Cron) ──────────────────────────────────
# Auto-set by Vercel. Set manually for local cron testing.
CRON_SECRET=another_strong_random_secret

# ── Site URL (used in payment return URIs) ────────────────────
NEXT_PUBLIC_SITE_URL=https://www.chinaprime.co.th
# Local dev:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
